OCR_PROVIDER=mock
PADDLE_USE_GPU=false
PADDLE_USE_ANGLE_CLS=false
PADDLE_LANG=korean
PADDLE_SHOW_LOG=false
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs
